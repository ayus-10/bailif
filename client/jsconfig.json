{
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "checkJs": true,
        "strict": true,
        "noImplicitAny": true,
        "moduleResolution": "bundler",
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
        }
    },
    "include": ["src/**/*.js", "src/**/*.vue"]
}

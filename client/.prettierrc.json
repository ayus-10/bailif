{
    "plugins": ["@ianvs/prettier-plugin-sort-imports"],
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "useTabs": false,
    "trailingComma": "es5",
    "printWidth": 80,
    "bracketSpacing": true,
    "arrowParens": "always",
    "vueIndentScriptAndStyle": false,
    "importOrder": ["^vue$", "^@/.*$", "^[./]"]
}
